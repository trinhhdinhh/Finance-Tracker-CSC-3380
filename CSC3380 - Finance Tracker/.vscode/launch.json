{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:8080",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        },

        {
            "name": "finance_tracker",
            "cwd": "finance_tracker",
            "request": "launch",
            "type": "dart",
            "program": "finance_tracker/lib/main.dart"
        },
        {
            "name": "finance_tracker (profile mode)",
            "cwd": "finance_tracker",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "finance_tracker (release mode)",
            "cwd": "finance_tracker",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        },
        {
            "name": "flutter_app",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "flutter_app (profile mode)",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "flutter_app (release mode)",
            "cwd": "flutter_app",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}